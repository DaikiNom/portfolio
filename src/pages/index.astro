<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import { MotionPathPlugin } from "gsap/all";
	gsap.registerPlugin(ScrollTrigger);
	gsap.registerPlugin(MotionPathPlugin);

	const cursor = document.querySelector(".cursor") as HTMLElement;
	const links = document.querySelectorAll("a");
	gsap.set(cursor, {
		opacity: 0,
	});
	document.addEventListener("load", () => {
		if ("ontouchstart" in window) {
			cursor.style.display = "none";
		} else {
				document.addEventListener("mousemove", () => {
		gsap.to(cursor, {
			opacity: 1,
			duration: 0.3,
			});
		});
		document.addEventListener("mouseleave", () => {
			gsap.to(cursor, {
				opacity: 0,
				duration: 0.5,
			});
		});
		document.addEventListener("mouseenter", () => {
			gsap.to(cursor, {
				opacity: 1,
				duration: 0.5,
			});
		});
		document.addEventListener("mousemove", (e) => {
			cursor.style.transform = `translate(${e.clientX}px, ${e.clientY}px)`;
		});
		links.forEach((link) => {
			link.addEventListener("mouseover", () => {
				cursor.classList.add("cursor--hover");
			});
			link.addEventListener("mouseleave", () => {
				cursor.classList.remove("cursor--hover");
			});
		});
		}
	});

	const tl = gsap.timeline();
	gsap.set(".name-mask-line", {
		strokeDashoffset: 10100,
	});
	gsap.set(".scroll-line", {
		y: 0,
		opacity: 0,
	});
	gsap.set(".header", {
		y: '-5rem',
	});
	gsap.set(".loading-circle", {
		transformOrigin: "50% 50%",
	});

	tl.to(".loading-circle.circle-light", {
    duration: 2,
    scale: 0.5,
    ease: 'sine.inOut',
	yoyo: true,
	repeat: -1,
    motionPath: {
		path: 'M 0 25 C 0 25 0 0 50 0 C 50 0 100 0 100 25 C 100 25 100 50 50 50 C 50 50 0 50 0 25 Z',
		autoRotate: true,
		start: 0,
		end: 1,
		}
	})
	.to(".loading-circle.circle-dark", {
		duration: 2.5,
		scale: 0.5,
		ease: 'sine.inOut',
		yoyo: true,
		repeat: -1,
		motionPath: {
			path: 'M 0 25 C 0 25 0 0 50 0 C 50 0 100 0 100 25 C 100 25 100 50 50 50 C 50 50 0 50 0 25 Z',
		autoRotate: true,
		start: 0.5,
		end: 2,
		}
	}, '<')
	.to(".loading", {
		opacity: 0,
		y: "-100%",
		ease: "power1.InOut",
		delay: 0.5,
	})
	.to(".name-mask-line", {
		strokeDashoffset: 0,
		duration: 3,
		ease: "power1.Out",
		delay: 0.3,
	})
	.to(".header", {
		y: 0,
		duration: 1,
		ease: "power1.InOut",
	})
	.to(".scroll-line", {
		opacity: 0.5,
		duration: 0.75,
		ease: "power1.In",
	}, '<')
	.to(".scroll-line", {
		y: -20,
		opacity: 0.8,
		duration: 1.5,
		repeat: -1,
		yoyo: true,
		ease: "power1.InOut",
	});

	const careerTimeline = document.querySelectorAll<HTMLElement>(".career-timeline-item-date");
	careerTimeline.forEach((date) => {
		const targetYear = date.dataset.year;
		if (!targetYear) return;
		const count = { count: 0 };
		gsap.to(count, {
			count: parseInt(targetYear),
			duration: 1,
			ease: "power1.In",
			scrollTrigger: {
				trigger: date,
				start: "top 85%",
				toggleActions: "play none none reverse",
			},
			onUpdate: () => {
				date.textContent = Math.floor(count.count).toString().padStart(4, "0");
			},
		});
	});


	const container = document.querySelector(".works-container");
	const items = document.querySelectorAll(".item");
	gsap.set(container, {
		width: 100 * items.length + "%",
	});
	gsap.set(items, {
		width: 100 / items.length + "%",
	});

	gsap.to(".item", {
		xPercent: -100 * (items.length - 1),
		ease: "none",
		scrollTrigger: {
			trigger: container,
			start: "top top",
			end: () => "+=" + ((container as HTMLElement)?.offsetWidth - innerWidth || 0),
			scrub: true,
			pin: true,
			anticipatePin: 1,
			snap: 1 / (items.length - 1),
		},
	});
</script>