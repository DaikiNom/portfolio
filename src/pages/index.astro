---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/header.astro";
import Career from "@/components/career.astro";
import Works from "@/components/works.astro";

import Image from "astro/components/Image.astro";
import { getImage } from 'astro:assets';
import backgroundImagePath from "@/assets/background.jpg";
const backgroundImage = await getImage({ src: backgroundImagePath, format: 'webp' });
import profileImage from "@/assets/profile.jpg";

import "@fontsource/lato/400.css";

import { getWorks } from "@/lib/microcms";
const works = await getWorks();
