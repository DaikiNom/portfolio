---
import "@fontsource-variable/noto-serif-jp";

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Daiki Nomura</title>
		<meta property="og:title" content="Daiki Nomura" />
		<meta property="og:description" content="Daiki Nomura's Portfolio" />
		<meta property="og:url" content="https://daikinomura.tech/" />
		<meta property="og:type" content="profile" />
	</head>
	<body>
		<slot />
		<footer>
			<p class="copyright">
				Copyright &copy; 2022 - {year}
				<a href="https://github.com/DaikiNom">Daiki Nomura</a>
			</p>
		</footer>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		font-family: "Noto Serif JP", serif;
	}
	footer {
		width: 100%;
		padding: 1rem 0;
	}
	.copyright {
		text-align: center;
		font-size: 0.8rem;
	}
</style>
